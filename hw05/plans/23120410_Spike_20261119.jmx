            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify detail and build request JSON" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

if (prev.getResponseCode() != '200') {
    return
}
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (body.id?.toString() != vars.get('product_id') || body.name != vars.get('listed_product_name')) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Product detail must match the product selected from the list.')
        return
    }
    long price = new BigDecimal(body.price.toString()).longValueExact()
    int quantity = Integer.parseInt(vars.get('quantity'))
    if (price &lt;= 0 || quantity &lt;= 0) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Price and quantity must be positive.')
        return
    }
    vars.put('cart_body', JsonOutput.toJson([
        id: body.id, name: body.name, price: price, quantity: quantity,
    ]))
    vars.put('checkout_body', JsonOutput.toJson([
        total_amount: Math.multiplyExact(price, (long) quantity), shipping_address: vars.get('shipping_address'),
    ]))
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Unexpected JSON or field type for this step.')
}</stringProp>
            </JSR223Assertion>
