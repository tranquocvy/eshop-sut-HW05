            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify matching product in search results" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

if (prev.getResponseCode() != '200') {
    return
}
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def selected = body instanceof List ? body.find { it.id?.toString() == vars.get('fixture_product_id') } : null
    if (selected == null || vars.get('product_id') != vars.get('fixture_product_id')
            || !(selected.name instanceof String) || selected.name.isEmpty()) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('The CSV product must be present in search results.')
        return
    }
    vars.put('listed_product_name', selected.name)
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Unexpected JSON or field type for this step.')
}</stringProp>
            </JSR223Assertion>
