            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify login and expected account" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

if (prev.getResponseCode() != '200') {
    return
}
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def userId = body.user?.id?.toString()
    def expectedId = vars.get('expected_user_id')
    if (body.message != 'Login successful' || body.user?.role != 'user'
            || body.user?.email != vars.get('email') || !(userId ==~ /[1-9][0-9]*/)
            || (expectedId &amp;&amp; userId != expectedId)
            || !(vars.get('jwt') ==~ /[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Login must return a JWT for the provisioned user.')
        return
    }
    vars.put('authenticated_user_id', userId)
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Unexpected JSON or field type for this step.')
}</stringProp>
            </JSR223Assertion>
            <hashTree />
          </hashTree>
